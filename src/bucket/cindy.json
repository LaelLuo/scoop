{
    "version": "0.1.145",
    "description": "An open-source, out-of-the-box AI agent. Cross-device sessions stay on the original machine.",
    "homepage": "https://cindy.app",
    "license": "Apache-2.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/makecindy/cindy/releases/download/v0.1.145/cindy-0.1.145-win32-x64-global.exe#/dl.7z",
            "hash": "9f7ed6736544b8f8595e8baefd56994eab6f8e7e60302b5ee38897c85a911283",
            "pre_install": [
                "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
                "Remove-Item \"$dir\\`$*\", \"$dir\\*.nsi\" -Recurse -ErrorAction SilentlyContinue"
            ]
        }
    },
    "shortcuts": [
        [
            "Cindy.exe",
            "Cindy",
            "--user-data-dir=\"$dir\\..\\..\\..\\persist\\cindy\\roaming\""
        ]
    ],
    "notes": [
        "这是 Cindy 国际版（global）构建，默认连接官方国际区云服务。中国区账号请安装 cindy-cn。",
        "跨设备续接、记忆和 Skills 同步依赖官方账号；选择 Skip Sign-In 时这些服务端能力不可用。",
        "项目文件留在原机器，不是整盘同步。请用 scoop update cindy 更新。",
        "国际版 Electron userData 是 %APPDATA%\\CindyGlobal；应用还会把共享技能写入 %APPDATA%\\Cindy。便携化会把这两处分别映射到各自 Scoop persist；不要与 cindy-cn 同时安装。",
        "国际版快捷方式带 --user-data-dir 参数指向 Scoop persist；直接运行 Cindy.exe 时请自行带同一参数，否则不会进入 persist。"
    ],
    "checkver": {
        "github": "https://github.com/makecindy/cindy"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/makecindy/cindy/releases/download/v$version/cindy-$version-win32-x64-global.exe#/dl.7z"
            }
        }
    },
    "portableProfile": {
        "mappings": [
            {
                "label": "roaming",
                "source": "AppData/CindyGlobal",
                "target": "$persist_dir/roaming",
                "strategy": "symlink",
                "ensureTarget": true
            },
            {
                "label": "shared-skills",
                "source": "AppData/Cindy/shared-system-skills",
                "target": "$persist_dir/shared/system-skills",
                "strategy": "symlink",
                "ensureTarget": true
            },
            {
                "label": "shared-skill-locks",
                "source": "AppData/Cindy/shared-skill-mutation-locks",
                "target": "$persist_dir/shared/skill-mutation-locks",
                "strategy": "symlink",
                "ensureTarget": true
            }
        ]
    }
}
