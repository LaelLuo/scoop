{
    "version": "0.12.1",
    "description": "Project management for human + agent teams",
    "homepage": "https://multica.ai",
    "license": {
        "identifier": "Apache-2.0",
        "url": "https://github.com/multica-ai/multica/blob/main/LICENSE"
    },
    "architecture": {
        "64bit": {
            "url": "https://github.com/multica-ai/multica/releases/download/v0.12.1/multica-desktop-0.12.1-windows-x64.exe#/dl.7z",
            "hash": "sha512:907fa4b72655d731934604d1297cbee0f2eb2938f35aade08a90f0275ab63eff16914c3f1331ee45c447643a4703c993d901be3d6a0703faf10d2065e66d9944",
            "pre_install": [
                "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
                "Remove-Item \"$dir\\`$*\", \"$dir\\*.nsi\" -Recurse"
            ]
        },
        "arm64": {
            "url": "https://github.com/multica-ai/multica/releases/download/v0.12.1/multica-desktop-0.12.1-windows-arm64.exe#/dl.7z",
            "hash": "sha512:b32868061199b575bdc3646cfe9301996c357837658eccbdea13501e4e9bdb2fa32fb08d9163ab73fba33d7f1bffa2feed2e09194f3c6f79ad3b59be52d4cf53",
            "pre_install": [
                "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-arm64.7z\" \"$dir\"",
                "Remove-Item \"$dir\\`$*\", \"$dir\\*.nsi\" -Recurse"
            ]
        }
    },
    "shortcuts": [
        [
            "Multica.exe",
            "Multica"
        ]
    ],
    "checkver": {
        "github": "https://github.com/multica-ai/multica"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/multica-ai/multica/releases/download/v$version/multica-desktop-$version-windows-x64.exe#/dl.7z",
                "hash": {
                    "url": "$baseurl/latest.yml",
                    "regex": "sha512:\\s*$base64"
                }
            },
            "arm64": {
                "url": "https://github.com/multica-ai/multica/releases/download/v$version/multica-desktop-$version-windows-arm64.exe#/dl.7z",
                "hash": {
                    "url": "$baseurl/latest-arm64.yml",
                    "regex": "sha512:\\s*$base64"
                }
            }
        }
    },
    "portableProfile": {
        "mappings": [
            {
                "label": "roaming",
                "source": "AppData/Multica",
                "target": "$persist_dir/roaming",
                "strategy": "symlink",
                "ensureTarget": true
            },
            {
                "label": "home-profiles",
                "source": "UserProfile/.multica/profiles",
                "target": "$persist_dir/home/profiles",
                "strategy": "symlink",
                "ensureTarget": true
            }
        ]
    },
    "notes": [
        "本清单复制自 extras/multica，目的是加入 portableProfile 便携化。",
        "数据目录是 %APPDATA%\\Multica（Electron userData）和 %USERPROFILE%\\.multica\\profiles（桌面 profile）。",
        "便携化只映射这两个目录，不整体接管 ~/.multica，避免影响同机 CLI profile；请用 scoop update multica 更新，并尽量关闭应用内自动更新。"
    ]
}
