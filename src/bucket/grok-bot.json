{
    "version": "1.2.3",
    "description": "Always-on AI agents from xAI and Cursor that work autonomously across your tools and apps.",
    "homepage": "https://x.ai/bot",
    "license": {
        "identifier": "Proprietary",
        "url": "https://x.ai/legal/terms-of-service"
    },
    "architecture": {
        "64bit": {
            "url": "https://downloads.cursor.com/grokbot/stable/win32-x64/1.2.3/Grok_Bot_1.2.3_Setup.exe#/dl.7z",
            "hash": "85b9e8d10b9ede921b315bb5a1b52db7e0f3438d162aacedfc388c778217765b",
            "pre_install": [
                "$procs = @(Get-Process -Name 'Grok Bot' -ErrorAction SilentlyContinue); if ($procs.Count -gt 0) { throw 'Grok Bot is running. Quit it before install/update; Scoop will not stop the process.' }",
                "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\""
            ]
        },
        "arm64": {
            "url": "https://downloads.cursor.com/grokbot/stable/win32-arm64/1.2.3/Grok_Bot_1.2.3_Setup.exe#/dl.7z",
            "hash": "476e46be39f79c3f7d14cdcc1560c3fe42ef813c849359c5b6ba492ff4bbdafa",
            "pre_install": [
                "$procs = @(Get-Process -Name 'Grok Bot' -ErrorAction SilentlyContinue); if ($procs.Count -gt 0) { throw 'Grok Bot is running. Quit it before install/update; Scoop will not stop the process.' }",
                "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-arm64.7z\" \"$dir\""
            ]
        }
    },
    "post_install": "Remove-Item \"$dir\\`$*\", \"$dir\\Uninst*\" -Recurse -ErrorAction Ignore",
    "shortcuts": [
        [
            "Grok Bot.exe",
            "Grok Bot"
        ]
    ],
    "portableProfile": {
        "mappings": [
            {
                "label": "roaming",
                "source": "AppData/Grok Bot",
                "target": "$persist_dir/roaming",
                "strategy": "symlink",
                "ensureTarget": true
            },
            {
                "label": "programs",
                "source": "LocalAppData/Programs/Grok Bot",
                "target": "$persist_dir/programs/grok-bot-updater-blocker",
                "strategy": "symlink",
                "ensureTarget": true,
                "targetType": "file"
            }
        ],
        "options": {
            "log": true
        }
    },
    "checkver": {
        "url": "https://api2.cursor.sh/updates/api/update/win32-x64/sand/0.0.0/stable",
        "jsonpath": "$.version",
        "regex": "^([\\d.]+)$"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://downloads.cursor.com/grokbot/stable/win32-x64/$version/Grok_Bot_$version_Setup.exe#/dl.7z"
            },
            "arm64": {
                "url": "https://downloads.cursor.com/grokbot/stable/win32-arm64/$version/Grok_Bot_$version_Setup.exe#/dl.7z"
            }
        }
    },
    "notes": [
        "本 laelluo 包与 extras 同名，都叫 grok-bot。建议用 scoop install laelluo/grok-bot，或先卸载 extras 再安装。",
        "安装、更新、卸载前请完全退出 Grok Bot；Scoop 不会杀进程。",
        "更新请用 scoop update grok-bot，并在设置里关闭应用内自动更新。",
        "安装时，已有的 %APPDATA%\\Grok Bot 会按相对路径和文件大小核对后迁移到 persist\\roaming，原位置改名为 *.scoop-portable-backup。确认应用正常后可删除备份。",
        "%LOCALAPPDATA%\\Programs\\Grok Bot 会由指向 persist\\programs\\grok-bot-updater-blocker 的文件符号链接接管。该位置已有的真实目录会被当作旧 NSIS 更新树删除；它不是用户数据。",
        "如果 AppData 仍是普通目录而 persist\\roaming 已有不同数据，安装会拒绝合并。",
        "普通卸载只移除本清单创建的符号链接；Scoop persist 和 *.scoop-portable-backup 备份保留。"
    ]
}
