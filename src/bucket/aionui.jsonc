{
    "version": "2.2.2",
    "description": "Transform your command-line AI agent into a modern, efficient AI chat interface.",
    "homepage": "https://www.aionui.com/",
    "license": "Apache-2.0",
    "architecture": {
        "64bit": {
            "url": "https://static.aionui.com/releases/2.2.2/AionUi-2.2.2-win-x64.exe#/dl.7z",
            "hash": "0ad9fb6e6619067706af0d5ee7e3588311b14b2fa2047db4d0633cf8e0adf88e",
            "pre_install": [
                "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
                "Remove-Item \"$dir\\`$*\", \"$dir\\Uninstall*\" -Recurse -ErrorAction SilentlyContinue"
            ]
        }
    },
    "shortcuts": [
        [
            "AionUi.exe",
            "AionUi"
        ]
    ],
    "portableProfile": {
        "mappings": [
            {
                "label": "roaming",
                "source": "AppData/AionUi",
                "target": "$persist_dir/roaming",
                "strategy": "symlink",
                "ensureTarget": true
            },
            {
                "label": "updater",
                "source": "LocalAppData/aionui-updater",
                "target": "$persist_dir/local/aionui-updater",
                "strategy": "symlink",
                "ensureTarget": true,
                "targetType": "file"
            }
        ],
        "options": {
            "log": true
        }
    },
    "persist": "data",
    "checkver": {
        "github": "https://github.com/iOfficeAI/AionUi"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://static.aionui.com/releases/$version/AionUi-$version-win-x64.exe#/dl.7z",
                "hash": {
                    "mode": "download"
                }
            }
        }
    }
}
