{
    "version": "2.1.30",
    "description": "Transform your command-line AI agent into a modern, efficient AI chat interface.",
    "homepage": "https://www.aionui.com/",
    "license": "Apache-2.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/iOfficeAI/AionUi/releases/download/v2.1.30/AionUi-2.1.30-win-x64.exe#/dl.7z",
            "hash": "sha512:edde6c9ea85943d7ab38f7b86276ecc13fffdba8f817301e63d9c8bb1b8c42247a074fb04451fc2f0ec8641ae6e7e00b1012c43228bc5494111ef0794d401537",
            "pre_install": [
                "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
                "Remove-Item \"$dir\\`$*\", \"$dir\\Uninstall*\" -Recurse -ErrorAction SilentlyContinue"
            ]
        },
        "arm64": {
            "url": "https://github.com/iOfficeAI/AionUi/releases/download/v2.1.30/AionUi-2.1.30-win-arm64.exe#/dl.7z",
            "hash": "sha512:759a7d7bd7dadb5c23be6a060200265c1d5d765662a847130ba0b7decfcff058ae0e2704c5b2292483a11ec3b2414be1cd17b01442b55fdce1b17c1c0430659f",
            "pre_install": [
                "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-arm64.7z\" \"$dir\"",
                "Remove-Item \"$dir\\`$*\", \"$dir\\Uninstall*\" -Recurse -ErrorAction SilentlyContinue"
            ]
        }
    },
    "shortcuts": [
        [
            "AionUi.exe",
            "AionUi"
        ]
    ],
    "portableProfile": {
        "mappings": [
            {
                "label": "roaming",
                "source": "AppData/AionUi",
                "target": "$persist_dir/roaming",
                "strategy": "symlink",
                "ensureTarget": true
            },
            {
                "label": "updater",
                "source": "LocalAppData/aionui-updater",
                "target": "$persist_dir/local/aionui-updater",
                "strategy": "symlink",
                "ensureTarget": true,
                "targetType": "file"
            }
        ],
        "options": {
            "log": true
        }
    },
    "persist": "data",
    "checkver": {
        "github": "https://github.com/iOfficeAI/AionUi"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/iOfficeAI/AionUi/releases/download/v$version/AionUi-$version-win-x64.exe#/dl.7z",
                "hash": {
                    "url": "$baseurl/latest.yml",
                    "regex": "sha512:\\s+$base64"
                }
            },
            "arm64": {
                "url": "https://github.com/iOfficeAI/AionUi/releases/download/v$version/AionUi-$version-win-arm64.exe#/dl.7z",
                "hash": {
                    "url": "$baseurl/latest-win-arm64.yml",
                    "regex": "sha512:\\s+$base64"
                }
            }
        }
    }
}
