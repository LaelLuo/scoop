{
    "version": "2.1.31",
    "description": "Transform your command-line AI agent into a modern, efficient AI chat interface.",
    "homepage": "https://www.aionui.com/",
    "license": "Apache-2.0",
    "architecture": {
        "64bit": {
            "url": "https://github.com/iOfficeAI/AionUi/releases/download/v2.1.31/AionUi-2.1.31-win-x64.exe#/dl.7z",
            "hash": "sha512:29f704730c6dc05ba9b2f076d6cf5f2d4107670a4132270b7b03366d6f6c776201c495fbd4fab4f67d720e3b76499d343e0fa11328f874ed0ac6720e146fcd7e",
            "pre_install": [
                "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-64.7z\" \"$dir\"",
                "Remove-Item \"$dir\\`$*\", \"$dir\\Uninstall*\" -Recurse -ErrorAction SilentlyContinue"
            ]
        },
        "arm64": {
            "url": "https://github.com/iOfficeAI/AionUi/releases/download/v2.1.31/AionUi-2.1.31-win-arm64.exe#/dl.7z",
            "hash": "sha512:c0a7a5e901f946f87a18f4f789fe46d4f39fcf32c64aabbcbf9d8b883cbae768f7be321a55a6cc1607ff079c9bb85024a0a2408d6306dfdf7d4b2d4f5b858d6b",
            "pre_install": [
                "Expand-7zipArchive \"$dir\\`$PLUGINSDIR\\app-arm64.7z\" \"$dir\"",
                "Remove-Item \"$dir\\`$*\", \"$dir\\Uninstall*\" -Recurse -ErrorAction SilentlyContinue"
            ]
        }
    },
    "shortcuts": [
        [
            "AionUi.exe",
            "AionUi"
        ]
    ],
    "portableProfile": {
        "mappings": [
            {
                "label": "roaming",
                "source": "AppData/AionUi",
                "target": "$persist_dir/roaming",
                "strategy": "symlink",
                "ensureTarget": true
            },
            {
                "label": "updater",
                "source": "LocalAppData/aionui-updater",
                "target": "$persist_dir/local/aionui-updater",
                "strategy": "symlink",
                "ensureTarget": true,
                "targetType": "file"
            }
        ],
        "options": {
            "log": true
        }
    },
    "persist": "data",
    "checkver": {
        "github": "https://github.com/iOfficeAI/AionUi"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/iOfficeAI/AionUi/releases/download/v$version/AionUi-$version-win-x64.exe#/dl.7z",
                "hash": {
                    "url": "$baseurl/latest.yml",
                    "regex": "sha512:\\s+$base64"
                }
            },
            "arm64": {
                "url": "https://github.com/iOfficeAI/AionUi/releases/download/v$version/AionUi-$version-win-arm64.exe#/dl.7z",
                "hash": {
                    "url": "$baseurl/latest-win-arm64.yml",
                    "regex": "sha512:\\s+$base64"
                }
            }
        }
    }
}
