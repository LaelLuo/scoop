{
    "version": "9.9.33.260813",
    "description": "An instant messaging software service developed by Tencent",
    "homepage": "https://im.qq.com/pcqq/index.shtml",
    "license": {
        "identifier": "Proprietary",
        "url": "https://ti.qq.com/agreement/index.html"
    },
    "architecture": {
        "64bit": {
            "url": "https://qqdl.gtimg.cn/qqfile/QQNT/9.9.33/release/497e2f1f/QQ_9.9.33_260813_x64_01.exe#/dl.7z",
            "hash": "b25c0d3ce9df764074a9118d0ded927e1b2d7ebf60e306112e8df18a040ec492"
        },
        "32bit": {
            "url": "https://qqdl.gtimg.cn/qqfile/QQNT/9.9.33/release/497e2f1f/QQ_9.9.33_260813_x86_01.exe#/dl.7z",
            "hash": "fd7214c7a70a6e0eb46781e0d653d5c56b0d496d2f710b4d5c07939c40b73be6"
        },
        "arm64": {
            "url": "https://qqdl.gtimg.cn/qqfile/QQNT/9.9.33/release/497e2f1f/QQ_9.9.33_260813_arm64_01.exe#/dl.7z",
            "hash": "ee77d6d8bdfc4f4c9bf9c6d2521322ff410d2614a7e8ba005aaa9703fc9ef174"
        }
    },
    "extract_dir": "Files",
    "shortcuts": [
        [
            "QQ.exe",
            "QQ"
        ]
    ],
    "portableProfile": {
        "mappings": [
            {
                "label": "roaming",
                "source": "AppData/QQ",
                "target": "$persist_dir/roaming",
                "strategy": "symlink",
                "ensureTarget": true
            },
            {
                "label": "qqex",
                "source": "AppData/QQEX",
                "target": "$persist_dir/qqex",
                "strategy": "symlink",
                "ensureTarget": true
            },
            {
                "label": "tencent-qqnt",
                "source": "AppData/Tencent/QQNT",
                "target": "$persist_dir/tencent-qqnt",
                "strategy": "symlink",
                "ensureTarget": true
            },
            {
                "label": "chat-updater",
                "source": "LocalAppData/qq-chat-updater",
                "target": "$persist_dir/updater-blocker",
                "strategy": "symlink",
                "ensureTarget": true,
                "targetType": "file"
            },
            {
                "label": "play-updater",
                "source": "LocalAppData/qq-play-updater",
                "target": "$persist_dir/updater-blocker",
                "strategy": "symlink",
                "ensureTarget": true,
                "targetType": "file"
            }
        ],
        "options": {
            "log": true
        }
    },
    "checkver": {
        "script": [
            "# Please keep this script. An empty Accept-Encoding header can cause the CDN to deliver expired cache.",
            "# See : https://github.com/ScoopInstaller/Extras/issues/15916",
            "$headers = @{ 'Accept-Encoding' = 'gzip' }",
            "$url = 'https://cdn-go.cn/qq-web/im.qq.com_new/latest/rainbow/windowsConfig.js'",
            "$response = Invoke-WebRequest -Uri $url -UseBasicParsing -Headers $headers",
            "Write-Output $response.Content"
        ],
        "regex": "(?<url>https://qqdl\\.gtimg\\.cn/qqfile/QQNT(?:V2)?/([\\d\\.]+)/release/([0-9a-f]+)/QQ_([\\d\\.]+)_([\\d]+)_x86_01\\.exe)",
        "replace": "${3}.${4}"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://qqdl.gtimg.cn/qqfile/QQNTV2/$match1/release/$match2/QQ_$match3_$match4_x64_01.exe#/dl.7z"
            },
            "32bit": {
                "url": "https://qqdl.gtimg.cn/qqfile/QQNTV2/$match1/release/$match2/QQ_$match3_$match4_x86_01.exe#/dl.7z"
            },
            "arm64": {
                "url": "https://qqdl.gtimg.cn/qqfile/QQNTV2/$match1/release/$match2/QQ_$match3_$match4_arm64_01.exe#/dl.7z"
            }
        }
    },
    "notes": [
        "2026-09-15 实测：腾讯新分发路径 qqfile/QQNTV2（9.9.35 起独占）对 curl/WinHTTP/aria2 等脚本下载器一律 403（Server: Lego Server），仅老路径 qqfile/QQNT 开放，因此 autoupdate 到 9.9.35+ 会因 hash 下载失败而报错。",
        "当前版本 9.9.33 停在老路径最后一个可下载版本，url 与 sha256 取自 winget-pkgs 仓库 Tencent.QQ.NT 9.9.33.52230 清单（老路径 200 实测可下）。",
        "解除办法：等腾讯放开 QQNTV2 匿名下载，或手动浏览器下载新版安装包算 hash 后手改清单。"
    ]
}
