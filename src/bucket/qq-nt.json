    "extract_dir": "Files",
    "shortcuts": [
        [
            "QQ.exe",
            "QQ"
        ]
    ],
    "portableProfile": {
        "mappings": [
            {
                "label": "roaming",
                "source": "AppData/QQ",
                "target": "$persist_dir/roaming",
                "strategy": "symlink",
                "ensureTarget": true
            },
            {
                "label": "qqex",
                "source": "AppData/QQEX",
                "target": "$persist_dir/qqex",
                "strategy": "symlink",
                "ensureTarget": true
            },
            {
                "label": "tencent-qqnt",
                "source": "AppData/Tencent/QQNT",
                "target": "$persist_dir/tencent-qqnt",
                "strategy": "symlink",
                "ensureTarget": true
            },
            {
                "label": "chat-updater",
                "source": "LocalAppData/qq-chat-updater",
                "target": "$persist_dir/updater-blocker",
                "strategy": "symlink",
                "ensureTarget": true,
                "targetType": "file"
            },
            {
                "label": "play-updater",
                "source": "LocalAppData/qq-play-updater",
                "target": "$persist_dir/updater-blocker",
                "strategy": "symlink",
                "ensureTarget": true,
                "targetType": "file"
            }
        ],
        "options": {
            "log": true
        }
    },
    "checkver": {
        "script": [
            "# Please keep this script. An empty Accept-Encoding header can cause the CDN to deliver expired cache.",
            "# See : https://github.com/ScoopInstaller/Extras/issues/15916",
            "$headers = @{ 'Accept-Encoding' = 'gzip' }",
            "$url = 'https://cdn-go.cn/qq-web/im.qq.com_new/latest/rainbow/windowsConfig.js'",
            "$response = Invoke-WebRequest -Uri $url -UseBasicParsing -Headers $headers",
            "Write-Output $response.Content"
        ],
        "regex": "(?<url>https://qqdl\\.gtimg\\.cn/qqfile/QQNT(?:V2)?/([\\d\\.]+)/release/([0-9a-f]+)/QQ_([\\d\\.]+)_([\\d]+)_x86_01\\.exe)",
        "replace": "${3}.${4}"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://qqdl.gtimg.cn/qqfile/QQNTV2/$match1/release/$match2/QQ_$match3_$match4_x64_01.exe#/dl.7z"
            },
            "32bit": {
                "url": "https://qqdl.gtimg.cn/qqfile/QQNTV2/$match1/release/$match2/QQ_$match3_$match4_x86_01.exe#/dl.7z"
            },
            "arm64": {
                "url": "https://qqdl.gtimg.cn/qqfile/QQNTV2/$match1/release/$match2/QQ_$match3_$match4_arm64_01.exe#/dl.7z"
            }
        }
    },
    "notes": [
        "2026-09-15 终局定性：腾讯新分发路径 qqfile/QQNTV2（9.9.35 起独占）的裸链接对一切脚本下载器 403（Lego 网关）——**不是指纹问题，是缺签名**：官网点击下载时先 POST 免登录接口 https://im.qq.com/http2rpc/gotrpc/noauth/trpc.qqntv2.urlsign.UrlSign/GetSign（headers 带 x-oidb：{\"uint32_command\":\"0x9b8e\",\"uint32_service_type\":1}，body {url:裸链接}）换取带 ?sign=&t= 的签名 URL（打到 tencent-cos，任何客户端可下）。",
        "桶内已固化 scripts/qqnt-fetch.ps1（GetSign→下载→输出 sha256 一条龙，已实测哈希与浏览器下载一致）。清单版本钉 9.9.33 的原因：scoop 自身的 autoupdate 下载器不会走签名流程，直接发布 9.9.35 会让任何环境的 install/update 403——**勿把需签名的版本号直接发布进清单**（09-15 曾误推后即回退）。",
        "新版本升级流程（全自动，无需浏览器人工）：①qqnt-fetch.ps1 下载并取 hash；②改清单 version/url/hash 三件套；③rm bucket/qq-nt.json 后 bun scripts/build.ts --only qq-nt（防产物回写洗回）再提交；④安装包复制为 D:\\Scoop\\cache\\qq-nt#<版本>#<sha256(url完整串含#/dl.7z)前【7】位>.7z（7 位不是 8 位）；⑤scoop update qq-nt 命中缓存装上；⑥装完把清单回退钉版再 push。",
        "替代通道：QQ 客户端自研热更新（QQEX 启动器式版本目录）不破坏 scoop 布局。夜巡遇 qq-nt autoupdate available 时优先走 qqnt-fetch.ps1 自动流程。"
    ]
}
