{
    "version": "9.9.35.260902",
    "description": "An instant messaging software service developed by Tencent",
    "homepage": "https://im.qq.com/pcqq/index.shtml",
    "license": {
        "identifier": "Proprietary",
        "url": "https://ti.qq.com/agreement/index.html"
    },
    "architecture": {
        "64bit": {
            "url": "https://qqdl.gtimg.cn/qqfile/QQNTV2/9.9.35/release/8a8b2a64/QQ_9.9.35_260902_x64_01.exe#/dl.7z",
            "hash": "9f4b408e7e33f6d74ddf2b117d6953367a42dbb41af6d82150482d3ffebf05f7"
        }
    },
    "extract_dir": "Files",
    "shortcuts": [
        [
            "QQ.exe",
            "QQ"
        ]
    ],
    "portableProfile": {
        "mappings": [
            {
                "label": "roaming",
                "source": "AppData/QQ",
                "target": "$persist_dir/roaming",
                "strategy": "symlink",
                "ensureTarget": true
            },
            {
                "label": "qqex",
                "source": "AppData/QQEX",
                "target": "$persist_dir/qqex",
                "strategy": "symlink",
                "ensureTarget": true
            },
            {
                "label": "tencent-qqnt",
                "source": "AppData/Tencent/QQNT",
                "target": "$persist_dir/tencent-qqnt",
                "strategy": "symlink",
                "ensureTarget": true
            },
            {
                "label": "chat-updater",
                "source": "LocalAppData/qq-chat-updater",
                "target": "$persist_dir/updater-blocker",
                "strategy": "symlink",
                "ensureTarget": true,
                "targetType": "file"
            },
            {
                "label": "play-updater",
                "source": "LocalAppData/qq-play-updater",
                "target": "$persist_dir/updater-blocker",
                "strategy": "symlink",
                "ensureTarget": true,
                "targetType": "file"
            }
        ],
        "options": {
            "log": true
        }
    },
    "checkver": {
        "script": [
            "# Please keep this script. An empty Accept-Encoding header can cause the CDN to deliver expired cache.",
            "# See : https://github.com/ScoopInstaller/Extras/issues/15916",
            "$headers = @{ 'Accept-Encoding' = 'gzip' }",
            "$url = 'https://cdn-go.cn/qq-web/im.qq.com_new/latest/rainbow/windowsConfig.js'",
            "$response = Invoke-WebRequest -Uri $url -UseBasicParsing -Headers $headers",
            "Write-Output $response.Content"
        ],
        "regex": "(?<url>https://qqdl\\.gtimg\\.cn/qqfile/QQNT(?:V2)?/([\\d\\.]+)/release/([0-9a-f]+)/QQ_([\\d\\.]+)_([\\d]+)_x86_01\\.exe)",
        "replace": "${3}.${4}"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://qqdl.gtimg.cn/qqfile/QQNTV2/$match1/release/$match2/QQ_$match3_$match4_x64_01.exe#/dl.7z"
            }
        }
    },
    "notes": [
        "2026-09-15 定性：腾讯新分发路径 qqfile/QQNTV2（9.9.35 起独占）对一切脚本下载器（curl/WinHTTP/aria2/curl-impersonate/无头/嵌入式 WebView2 的自动导航）一律 403（Server: Lego Server）；仅老路径 qqfile/QQNT 对脚本开放，且新路径对「真浏览器+真人点击」放行（含嵌入式 WebView2 的交互式下载）。",
        "因此本清单 autoupdate 的 hash 自动计算已不可行：新版本升级需人工在浏览器里下载安装包算 hash（本次 9.9.35.260902 即此法，文件 sha256 本地实测），且 scoop 安装/更新会因自动下载 403 失败——需把安装包按缓存命名规则（qq-nt#<版本>#<sha256(url)前8位>.7z）预填进 scoop cache 目录后再 update。",
        "已砍为单 64bit 架构（x86/arm64 的 9.9.35 hash 无来源）。夜巡对 qq-nt 的 autoupdate available 报错按「上游分发阻断待人工」处理，勿反复重试。",
        "替代更新通道：QQ 客户端自研热更新（QQEX/启动器式版本目录）不破坏 scoop 布局，平时可直接让 QQ 自更新，scoop 清单版本号会与实际运行版本脱节属预期。"
    ]
}
